:root{
  --bg:#0f0f12;
  --muted:#1a1a22;
  --text:#e9e9ee;
  --sub:#b7b7c4;
  --brand:#9dd0ff;
  --brand-ink:#0b2a44;
  --card:#14141a;
  --border:#2a2a34;
}

*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.6;
}

img{max-width:100%;height:auto;display:block}
a{color:var(--brand);text-decoration:none}
a:hover{opacity:.9}

.container{
  width:min(1100px, 92%);
  margin:0 auto;
}

.site-header{
  position:sticky; top:0; z-index:50;
  background:rgba(15,15,18,.8);
  backdrop-filter:saturate(140%) blur(8px);
  border-bottom:1px solid var(--border);
}
.site-header .container{
  display:flex; align-items:center; justify-content:space-between; padding:.8rem 0;
}
.logo{font-weight:700; letter-spacing:.4px; color:var(--text)}
.nav-toggle{display:none;background:transparent;border:1px solid var(--border);border-radius:6px;color:var(--text);padding:.4rem .6rem}
.nav ul{list-style:none;margin:0;padding:0;display:flex;gap:1rem}
.nav .btn{padding:.4rem .8rem;border:1px solid var(--border);border-radius:999px}

.hero{
  position:relative; overflow:hidden;
  border-bottom:1px solid var(--border);
}
.hero .container{padding:6rem 0 7rem; position:relative; z-index:2}
.hero h1{font-size:clamp(2rem,6vw,3.5rem);margin:0 0 .4rem}
.sub{color:var(--sub); max-width:55ch; margin-bottom:1.2rem}
.hero .btn-primary{margin-top:.5rem}
.hero-bg{
  position:absolute; inset:0;
  background:
    linear-gradient(180deg, rgba(15,15,18,0.1), rgba(15,15,18,0.95)),
    url('images/hero.jpg') center/cover no-repeat;
  opacity:.9;
}

.btn{
  display:inline-block; font-weight:600;
  border-radius:12px; padding:.7rem 1rem;
  transition:transform .08s ease, box-shadow .2s ease, background .2s ease;
}
.btn:hover{transform:translateY(-1px)}
.btn-primary{
  background:linear-gradient(180deg, #b6dcff, #8ec9ff);
  color:#06111a; box-shadow:0 6px 18px rgba(157,208,255,.25);
}

.gallery{padding:3.5rem 0}
.gallery h2, .about h2, .contact h2{font-size:1.8rem;margin:0 0 1rem}
.grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:14px;
}
.card{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:12px; overflow:hidden;
}
.card img{aspect-ratio:4/3; object-fit:cover}
.card figcaption{padding:.6rem .7rem; color:var(--sub); font-size:.95rem}

.cta{display:flex; justify-content:center; margin-top:1.2rem}

.about{
  display:grid; align-items:center; gap:2rem;
  grid-template-columns:1.1fr .9fr;
  padding:3.5rem 0; border-top:1px solid var(--border);
}
.about-text p{margin:.3rem 0 1rem}
.badges{list-style:none;display:flex;gap:.6rem;padding:0;margin:0;flex-wrap:wrap}
.badges li{
  background:var(--muted); color:var(--text);
  border:1px solid var(--border); border-radius:999px;
  padding:.3rem .7rem; font-size:.9rem
}
.about-photo img{border-radius:14px; border:1px solid var(--border); background:#000; aspect-ratio:4/3; object-fit:cover}

.contact{border-top:1px solid var(--border); padding:3.5rem 0}
.contact p{color:var(--sub)}
.contact-form{
  display:grid; gap:.9rem; margin-top:.6rem;
  background:var(--card); border:1px solid var(--border); padding:1rem; border-radius:12px;
}
.contact-form .row{display:grid; grid-template-columns:1fr 1fr; gap:.9rem}
label span{display:block; font-weight:500; margin-bottom:.35rem}
input, textarea{
  width:100%; background:#0e0e13; color:var(--text);
  border:1px solid var(--border); border-radius:10px; padding:.7rem .8rem;
}
input:focus, textarea:focus{outline:2px solid var(--brand)}
.social{margin-top:1rem; display:flex; gap:1rem; flex-wrap:wrap}

.site-footer{
  border-top:1px solid var(--border); padding:1.2rem 0; color:var(--sub)
}
.site-footer .container{display:flex; justify-content:space-between; align-items:center}
.to-top{border:1px solid var(--border); border-radius:10px; padding:.3rem .6rem}

@media (max-width: 900px){
  .grid{grid-template-columns:repeat(2,1fr)}
  .about{grid-template-columns:1fr; gap:1.2rem}
}
@media (max-width: 640px){
  .nav-toggle{display:inline-block}
  .nav ul{
    position:absolute; right:1rem; top:56px; background:var(--muted);
    border:1px solid var(--border); border-radius:12px; padding:.5rem;
    display:none; flex-direction:column; gap:.4rem; min-width:180px;
  }
  .nav ul.show{display:flex}
  .grid{grid-template-columns:1fr}
  .contact-form .row{grid-template-columns:1fr}
}
